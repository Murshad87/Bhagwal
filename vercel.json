{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/.well-known/atproto-did",
      "destination": "/.well-known/atproto-did"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/atproto-did",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
